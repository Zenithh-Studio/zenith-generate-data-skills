{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Zenith Production Package v1",
  "description": "Lossless seven-tab import contract. Additional application-specific metadata is permitted; cross-references are enforced by the CLI validator.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "overview",
    "research",
    "script",
    "visual_bible",
    "shots",
    "image_prompts",
    "motion_prompts"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "overview": {
      "type": "object",
      "required": [
        "project_id",
        "youtube_title",
        "youtube_description",
        "central_question",
        "historical_thesis"
      ],
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "youtube_title": {
          "type": "string",
          "minLength": 1
        },
        "youtube_description": {
          "type": "string",
          "minLength": 1
        },
        "central_question": {
          "type": "string",
          "minLength": 1
        },
        "historical_thesis": {
          "type": "string",
          "minLength": 1
        },
        "duration_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "shot_count": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": true
    },
    "research": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/research"
      }
    },
    "script": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/scene"
      }
    },
    "visual_bible": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/asset"
      }
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/shot"
      }
    },
    "image_prompts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/image"
      }
    },
    "motion_prompts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/motion"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "references": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "characters",
        "environments",
        "props"
      ],
      "properties": {
        "characters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "uniqueItems": true
        },
        "environments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "uniqueItems": true
        },
        "props": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "uniqueItems": true
        }
      }
    },
    "research": {
      "type": "object",
      "required": [
        "id",
        "type",
        "title"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "type": {
          "enum": [
            "CLAIM",
            "SOURCE"
          ]
        },
        "title": {
          "type": "string"
        },
        "source_url": {
          "type": "string"
        },
        "coverage": {
          "type": "string"
        },
        "verification": {
          "type": "string"
        },
        "caveat": {
          "type": "string"
        },
        "next_action": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "scene": {
      "type": "object",
      "required": [
        "id",
        "section",
        "narrative_question",
        "narration",
        "start_seconds",
        "end_seconds",
        "research_claim_ids"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "section": {
          "type": "string"
        },
        "narrative_question": {
          "type": "string"
        },
        "narration": {
          "type": "string",
          "minLength": 1
        },
        "start_seconds": {
          "type": "number",
          "minimum": 0
        },
        "end_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "words": {
          "type": "integer",
          "minimum": 1
        },
        "research_claim_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identifier"
          }
        }
      },
      "additionalProperties": true
    },
    "asset": {
      "type": "object",
      "required": [
        "id",
        "type",
        "name",
        "prompt_json"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "type": {
          "enum": [
            "CHARACTER",
            "ENVIRONMENT"
          ]
        },
        "name": {
          "type": "string"
        },
        "reference_requirement": {
          "type": "string"
        },
        "appearance": {
          "type": "string"
        },
        "consistency": {
          "type": "string"
        },
        "source_reference": {
          "type": "string"
        },
        "approval": {
          "type": "string"
        },
        "prompt_json": {
          "type": "object",
          "required": [
            "filename"
          ],
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "shot": {
      "type": "object",
      "required": [
        "id",
        "scene_id",
        "start_seconds",
        "end_seconds",
        "duration_seconds",
        "narration_anchor",
        "visual_concept",
        "image_prompt_id",
        "animation_id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "scene_id": {
          "$ref": "#/$defs/identifier"
        },
        "start_seconds": {
          "type": "number",
          "minimum": 0
        },
        "end_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "duration_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "narration_anchor": {
          "type": "string",
          "minLength": 1
        },
        "visual_concept": {
          "type": "string",
          "minLength": 1
        },
        "image_prompt_id": {
          "$ref": "#/$defs/identifier"
        },
        "animation_id": {
          "$ref": "#/$defs/identifier"
        },
        "fact_source_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identifier"
          }
        }
      },
      "additionalProperties": true
    },
    "image": {
      "type": "object",
      "required": [
        "id",
        "shot_id",
        "scene_id",
        "references",
        "prompt_json"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "shot_id": {
          "$ref": "#/$defs/identifier"
        },
        "scene_id": {
          "$ref": "#/$defs/identifier"
        },
        "references": {
          "$ref": "#/$defs/references"
        },
        "historical_sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "prompt_json": {
          "type": "object",
          "required": [
            "schema_version",
            "shot_id",
            "scene_id",
            "prompt_id",
            "narration_anchor",
            "references",
            "prompt",
            "negative_prompt",
            "output"
          ],
          "properties": {
            "references": {
              "$ref": "#/$defs/references"
            },
            "output": {
              "type": "object",
              "required": [
                "aspect_ratio"
              ],
              "properties": {
                "aspect_ratio": {
                  "enum": [
                    "16:9",
                    "9:16"
                  ]
                }
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "motion": {
      "type": "object",
      "required": [
        "id",
        "shot_id",
        "motion_method",
        "prompt_json"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "shot_id": {
          "$ref": "#/$defs/identifier"
        },
        "motion_method": {
          "type": "string"
        },
        "prompt_json": {
          "type": "object",
          "required": [
            "schema_version",
            "shot_id",
            "scene_id",
            "animation_id",
            "image_prompt_id",
            "references",
            "image_input",
            "motion_method",
            "prompt",
            "camera",
            "duration_seconds",
            "sound_design"
          ],
          "properties": {
            "references": {
              "$ref": "#/$defs/references"
            },
            "image_input": {
              "type": "object",
              "required": [
                "source",
                "image_prompt_id"
              ],
              "properties": {
                "source": {
                  "const": "generated_image"
                },
                "image_prompt_id": {
                  "$ref": "#/$defs/identifier"
                }
              },
              "additionalProperties": true
            },
            "sound_design": {
              "type": "object",
              "required": [
                "type",
                "prompt",
                "voice",
                "dialogue",
                "music",
                "generate_audio"
              ],
              "properties": {
                "type": {
                  "const": "diegetic_ambience_and_foley"
                },
                "prompt": {
                  "type": "string",
                  "minLength": 1
                },
                "voice": {
                  "const": false
                },
                "dialogue": {
                  "const": false
                },
                "music": {
                  "const": false
                },
                "generate_audio": {
                  "type": "boolean"
                },
                "allow_silence_if_not_applicable": {
                  "type": "boolean"
                }
              },
              "additionalProperties": true
            },
            "narration_anchor": false,
            "voice": false,
            "voice_over": false,
            "voiceover": false
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  }
}
